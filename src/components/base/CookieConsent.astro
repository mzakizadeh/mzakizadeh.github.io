---

---

<div id="cookie-consent" class="cookie-consent">
  <div class="cookie-content">
    <h3 class="cookie-title">Cookie Preferences</h3>
    <p class="cookie-description">
      I use cookies to improve your experience and analyze site usage.
    </p>

    <div class="cookie-buttons">
      <button id="accept-all" class="btn-primary">Accept</button>
      <button id="reject-all" class="btn-secondary">Reject</button>
    </div>
  </div>
</div>

<script define:vars={{ isDev: import.meta.env.DEV }}>
  function initCookieConsent() {
    const cookieConsent = document.getElementById("cookie-consent");
    const acceptAllBtn = document.getElementById("accept-all");
    const rejectAllBtn = document.getElementById("reject-all");

    // Check if user has already made a choice
    const cookiePreferences = localStorage.getItem("cookiePreferences");

    if (!cookiePreferences) {
      cookieConsent?.classList.add("show");
    } else {
      // Apply saved preferences
      applyPreferences(JSON.parse(cookiePreferences));
    }

    // Accept all cookies
    acceptAllBtn?.addEventListener("click", () => {
      const preferences = {
        necessary: true,
        analytics: true,
        timestamp: new Date().toISOString(),
      };
      saveAndApplyPreferences(preferences);
    });

    // Reject all optional cookies
    rejectAllBtn?.addEventListener("click", () => {
      const preferences = {
        necessary: true,
        analytics: false,
        timestamp: new Date().toISOString(),
      };
      saveAndApplyPreferences(preferences);
    });

    function saveAndApplyPreferences(preferences) {
      localStorage.setItem("cookiePreferences", JSON.stringify(preferences));
      localStorage.setItem("cookieConsent", "true"); // Legacy support
      cookieConsent?.classList.remove("show");
      applyPreferences(preferences);
    }

    function applyPreferences(preferences) {
      // Handle Microsoft Clarity
      if (preferences.analytics) {
        if (typeof window.clarity === "function") {
          window.clarity("consent");
          if (isDev) console.log("Clarity consent granted");
        }
      }

      // Handle Google Analytics
      if (preferences.analytics) {
        if (typeof window.gtag === "function") {
          window.gtag("consent", "update", {
            analytics_storage: "granted",
          });
          if (isDev) console.log("Google Analytics consent granted");
        }
      } else {
        if (typeof window.gtag === "function") {
          window.gtag("consent", "update", {
            analytics_storage: "denied",
          });
          if (isDev) console.log("Google Analytics consent denied");
        }
      }
    }
  }

  // Run on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCookieConsent);
  } else {
    initCookieConsent();
  }
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    max-width: 350px;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    border: 2px solid var(--primary);
    padding: 1.5rem;
    opacity: 0;
    transform: translateX(-120%);
    transition: all 0.4s ease;
    z-index: 9999;
    box-shadow: 0 0 20px rgba(27, 255, 19, 0.15);
    font-family: "Space Mono", sans-serif;
  }

  .cookie-consent.show {
    opacity: 1;
    transform: translateX(0);
  }

  .cookie-content {
    position: relative;
    z-index: 1;
  }

  .cookie-title {
    margin: 0 0 0.5rem 0;
    color: var(--primary);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cookie-description {
    margin: 0 0 1.25rem 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .cookie-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cookie-buttons button {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: "Space Mono", sans-serif;
    border: 2px solid var(--primary);
    box-sizing: border-box;
  }

  .btn-primary {
    background: var(--primary);
    color: #000000;
  }

  .btn-primary:hover {
    opacity: 0.8;
  }

  .btn-secondary {
    background: transparent;
    color: var(--primary);
  }

  .btn-secondary:hover {
    opacity: 0.8;
  }

  .cookie-buttons button:active {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .cookie-consent {
      bottom: 1rem;
      left: 1rem;
      right: 1rem;
      max-width: calc(100% - 2rem);
      padding: 1.25rem;
    }

    .cookie-title {
      font-size: 0.9rem;
    }

    .cookie-description {
      font-size: 0.75rem;
      margin-bottom: 1rem;
    }

    .cookie-buttons {
      gap: 0.6rem;
    }

    .cookie-buttons button {
      padding: 0.6rem 1rem;
      font-size: 0.7rem;
    }
  }
</style>
